# Локальные настройки (скопируйте в .env или задайте переменные окружения)
# Все параметры опциональны: значения по умолчанию безопасны (127.0.0.1:8000).

# Адрес и порт backend. Никогда не используйте 0.0.0.0 для локального MVP.
TELEGRAM_MANAGER_HOST=127.0.0.1
TELEGRAM_MANAGER_PORT=8000

# CORS: только локальный frontend (dev-сервер Vite по умолчанию :5173)
TELEGRAM_MANAGER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Каталог данных (sessions, app.db)
# TELEGRAM_MANAGER_DATA_DIR=C:\Projects\TelegramManager\data

# Отладка: включает /api/docs и подробные логи
TELEGRAM_MANAGER_DEBUG=false

# УРОВНИ: DEBUG, INFO, WARNING
TELEGRAM_MANAGER_LOG_LEVEL=INFO
